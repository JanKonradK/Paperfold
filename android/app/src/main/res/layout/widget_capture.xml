<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="locale">
<ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_background" android:scaleType="fitXY" android:importantForAccessibility="no"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
<TextView android:id="@+id/capture_note" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minHeight="48dp" android:minWidth="48dp" android:gravity="center" android:padding="4dp" android:text="@string/capture_note" android:textColor="#F3EBDD" android:textSize="14sp" android:maxLines="3" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackground"/>
<TextView android:id="@+id/capture_quote" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minHeight="48dp" android:minWidth="48dp" android:gravity="center" android:padding="4dp" android:text="@string/capture_quote" android:textColor="#F3EBDD" android:textSize="14sp" android:maxLines="3" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackground"/>
<TextView android:id="@+id/capture_pages" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minHeight="48dp" android:minWidth="48dp" android:gravity="center" android:padding="4dp" android:text="@string/capture_log_pages" android:textColor="#F3EBDD" android:textSize="14sp" android:maxLines="3" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackground"/>
</LinearLayout></FrameLayout>