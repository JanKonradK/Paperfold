<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="locale">
<ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_background" android:scaleType="fitXY" android:importantForAccessibility="no"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:gravity="center_vertical">
<ImageView android:id="@+id/book_cover" android:layout_width="32dp" android:layout_height="48dp" android:src="@drawable/widget_cover" android:scaleType="fitCenter"/>
<TextView android:id="@+id/book_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/widget_continue" android:textColor="#F3EBDD" android:textSize="16sp" android:fontFamily="serif" android:maxLines="2" android:ellipsize="end"/>
<ImageView android:id="@+id/progress_bar" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="8dp" android:importantForAccessibility="no"/>
<TextView android:id="@+id/book_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F3EBDD" android:textSize="14sp"/>
</LinearLayout></FrameLayout>